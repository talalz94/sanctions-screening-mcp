# Every environment variable this project reads, with no values. Copy this file to .env,
# fill in the ones you use and delete the rest: a line left empty still sets its variable,
# to an empty value. .env is ignored by git, so it is never committed. Nothing loads .env
# by itself: export the variables in your shell, or run
#   uv run --env-file .env sanctions ...
# src/sanctions_mcp/settings.py describes each one.

# Settings overrides (settings.toml holds the defaults)
SANCTIONS_LLM_PROVIDER=
SANCTIONS_LLM_MODEL=
SANCTIONS_LLM_EFFORT=
SANCTIONS_LLM_MAX_TOKENS=
SANCTIONS_PRICE_INPUT=
SANCTIONS_PRICE_OUTPUT=
SANCTIONS_PRICE_CACHE_READ=
SANCTIONS_AWS_REGION=
SANCTIONS_LLM_BASE_URL=

# Where the list, eval sets and models live (default ./data)
SANCTIONS_DATA_DIR=

# Provider anthropic
ANTHROPIC_API_KEY=

# Provider bedrock: fill in AWS_PROFILE (or the key pair) or AWS_BEARER_TOKEN_BEDROCK, then
# delete the lines you left empty. An empty AWS_BEARER_TOKEN_BEDROCK makes the SDK send an
# empty API key instead of using your AWS credentials, so the agent commands stop if they
# find one.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# Provider openai
OPENAI_API_KEY=

# Provider azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
